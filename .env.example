# PostgreSQL connection string for local development and the manual `db:*`
# commands (`db:migrate`, `db:seed`, `db:verify`).
#
# Copy this file to `.env.local` (gitignored) and replace the placeholder, or
# export DATABASE_URL in your shell. Real environment variables always win
# over values loaded from env files.
#
# No local PostgreSQL? Run `pnpm db:devdb` to boot an ephemeral embedded
# PostgreSQL 17 server and use the URL it prints. The automated test suite
# never reads this file: it boots its own ephemeral server (see
# ARCHITECTURE.md → Data Layer).
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/j_armando
