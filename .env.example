# PostgreSQL connection string for local development and the manual `db:*`
# commands (`db:migrate`, `db:seed`, `db:verify`).
#
# Copy this file to `.env.local` (gitignored) and replace the placeholder, or
# export DATABASE_URL in your shell. Real environment variables always win
# over values loaded from env files.
#
# No local PostgreSQL? Run `pnpm db:devdb` to boot an ephemeral embedded
# PostgreSQL 17 server and use the URL it prints. The automated test suite
# never reads this file: it boots its own ephemeral server (see
# ARCHITECTURE.md → Data Layer).
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/j_armando

# --- Google Gemini integration (Chat & Try-On) ------------------------------
# You can connect Google Gemini directly using your Google AI Studio API key.
# When GEMINI_API_KEY is provided, both the Chat Assistant and Virtual Try-On
# will prioritize Google Gemini models natively.
#
# GEMINI_API_KEY=AQ.Ab8...           # Google AI Studio API key
# GEMINI_CHAT_MODEL=gemini-2.5-flash # or gemini-3.8-flash, gemini-pro-latest
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image # model for virtual try-on image editing
#
# --- Chat assistant (LLM provider) ------------------------------------------
# The chat assistant is backed by OpenAI's Chat Completions API behind the
# ChatAssistant port (lib/chat/). All three variables are optional to build and
# run the app; without OPENAI_API_KEY the panel stays mounted but POST /api/chat
# responds 503 (and the panel shows an error line). The automated test suite
# never calls the live provider and needs no key (CONSTRAINTS.md).
#
# OPENAI_API_KEY=sk-...            # provider key (required to answer)
# CHAT_ASSISTANT_MODEL=gpt-4o-mini # defaults to gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1  # override for a compatible gateway

# --- Virtual try-on (image provider) ---------------------------------------
# Virtual try-on is backed by an OpenAI-compatible images API (the DevExpert
# gateway image-edit model) behind the TryOnProvider port (lib/try-on/). All
# three values are optional to build and run the app; without them POST
# /api/try-on responds 503 and the product-page panel shows a generic error.
# The automated test suite never calls the live provider and needs no key
# (CONSTRAINTS.md).
#
# TRYON_BASE_URL is the API base INCLUDING `/v1` (exactly like OPENAI_BASE_URL).
# The adapter appends only `/images/edits`, so this value must NOT include that
# path: https://inference.devexpert.io/v1 -> /v1/images/edits.
#
# TRYON_BASE_URL=https://inference.devexpert.io/v1
# TRYON_MODEL=image-edit
# TRYON_API_KEY=...                # falls back to DEVEXPERT_API_KEY, then OPENAI_API_KEY
